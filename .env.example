# Copy this file to .env.local (for local dev) and set real values.
# Never commit real values — .env.local is git-ignored.
#
# See docs/supabase-setup.md for how to obtain these.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase anon public key (starts with "eyJ..."). Safe to expose in
# the browser — RLS policies enforce access control, not the key.
VITE_SUPABASE_ANON_KEY=

# The single email allowed to sign into the app. Must match the value
# set in Postgres via:
#   alter database postgres set app.allowed_email = 'you@example.com';
VITE_ALLOWED_EMAIL=
